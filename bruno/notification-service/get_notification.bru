meta {
  name: Get Notification by ID
  type: http
  seq: 4
}

get {
  url: {{notificationServiceBaseUrl}}/api/notifications/{{notificationId}}
  body: none
  auth: none
}

script:pre-request {
  if (!bru.getVar("notificationId")) {
    console.warn("notificationId not set. Run 'Create Notification' first or using default ID.");
    bru.setVar("notificationId", "test-notification-123");
  }
}

tests {
  test("should return 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("should have service info in response", function() {
    expect(res.getBody()).to.have.property('service', 'notification-service');
  });
  
  test("should have success message", function() {
    expect(res.getBody()).to.have.property('message');
  });
  
  test("should have request_id for tracing", function() {
    expect(res.getBody()).to.have.property('request_id');
  });
  
  test("should indicate notifications are logged not stored", function() {
    const body = res.getBody();
    expect(body).to.have.property('note');
    expect(body.note).to.include('logged');
  });
}
