meta {
  name: Get All Orders (with Pagination)
  type: http
  seq: 6
}

get {
  url: {{orderServiceBaseUrl}}/orders?page=1&page_size=10
  body: none
  auth: none
}

tests {
  test("should return 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("should return message about implementation", function() {
    const body = res.getBody();
    expect(body).to.have.property('message');
    expect(body.message).to.include('GetAllOrders API endpoint');
  });
  
  test("should have pagination parameters", function() {
    const body = res.getBody();
    expect(body).to.have.property('page', 1);
    expect(body).to.have.property('page_size', 10);
  });
  
  test("should have request_id", function() {
    const body = res.getBody();
    expect(body).to.have.property('request_id');
  });
}
