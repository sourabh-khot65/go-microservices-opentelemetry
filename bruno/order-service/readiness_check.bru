meta {
  name: Order Service Readiness Check
  type: http
  seq: 2
}

get {
  url: {{orderServiceBaseUrl}}/ready
  body: none
  auth: none
}

tests {
  test("should return 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("should have service name", function() {
    expect(res.getBody()).to.have.property('service', 'order-service');
  });
  
  test("should be ready", function() {
    expect(res.getBody()).to.have.property('status', 'ready');
  });
}
