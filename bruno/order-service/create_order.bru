meta {
  name: Create Order
  type: http
  seq: 1
}

post {
  url: {{orderServiceBaseUrl}}/orders
  body: json
  auth: none
}

body:json {
  {
    "product_id": "9bdf7d75-e108-4dcd-a506-56acd2f0bcde",
    "quantity": 2
  }
}

tests {
  test("should return 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("should have id", function() {
    expect(res.getBody()).to.have.property('id');
  });
  test("should have product_id", function() {
    expect(res.getBody()).to.have.property('product_id');
  });
  test("should have quantity", function() {
    expect(res.getBody()).to.have.property('quantity');
  });
}
