meta {
  name: Create Order
  type: http
  seq: 7
}

post {
  url: {{orderServiceBaseUrl}}/orders
  body: json
  auth: none
}

body:json {
  {
    "product_id": "{{productId}}",
    "quantity": 2
  }
}

script:pre-request {
  if (!bru.getVar("productId")) {
    console.warn("productId not set. Run 'Create Product' first to set the variable.");
    // Fallback to a default product ID for testing
    bru.setVar("productId", "product-1");
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    const responseBody = res.getBody();
    if (responseBody && responseBody.id) {
      bru.setVar("orderId", responseBody.id);
      console.log("Order ID set:", responseBody.id);
    }
  }
}

tests {
  test("should return 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("should have order id", function() {
    const body = res.getBody();
    expect(body).to.have.property('id');
    expect(body.id).to.be.a('string');
  });
  
  test("should have correct product_id", function() {
    const body = res.getBody();
    expect(body).to.have.property('product_id');
    expect(body.product_id).to.equal(bru.getVar("productId"));
  });
  
  test("should have correct quantity", function() {
    const body = res.getBody();
    expect(body).to.have.property('quantity', 2);
  });
  
  test("should have status pending", function() {
    const body = res.getBody();
    expect(body).to.have.property('status', 'pending');
  });
  
  test("should have timestamps", function() {
    const body = res.getBody();
    expect(body).to.have.property('created_at');
    expect(body).to.have.property('updated_at');
  });
}
